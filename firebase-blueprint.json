{
  "entities": {
    "UserData": {
      "title": "UserData",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "userID": { "type": "string", "description": "The UID of the user" },
        "name": { "type": "string", "description": "The display name of the user" },
        "email": { "type": "string", "format": "email", "description": "The email of the user" },
        "photoURL": { "type": "string", "format": "uri", "description": "The profile photo URL" },
        "level": { "type": "number", "description": "The user's level" },
        "xp": { "type": "number", "description": "The user's experience points" },
        "createdAt": { "type": "number", "description": "Timestamp of account creation" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether the user has completed onboarding" },
        "settings": { "type": "object", "description": "User specific settings" },
        "profiles": { "type": "array", "description": "User AI profiles" },
        "darkPackAccess": { "type": "boolean", "description": "Whether the user has access to the Dark Pack (NSFW and Manipulation modes)" },
        "coursesAccess": { "type": "boolean", "description": "Whether the user has access to the Courses module" }
      },
      "required": ["userID", "name", "email", "level", "xp", "createdAt", "onboardingCompleted"]
    },
    "UserAIProfile": {
      "title": "UserAIProfile",
      "description": "The AI behavior profile for a user",
      "type": "object",
      "properties": {
        "userID": { "type": "string", "description": "The UID of the user" },
        "goal": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "communicationStyle": { "type": "string" },
        "flirtLevel": { "type": "string" },
        "responseLength": { "type": "string" },
        "mainPlatform": { "type": "string" },
        "conversationGoal": { "type": "string" },
        "personalityType": { "type": "string" }
      },
      "required": ["userID", "goal", "experienceLevel", "communicationStyle", "flirtLevel", "responseLength", "mainPlatform", "conversationGoal", "personalityType"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A conversation analyzed by the AI",
      "type": "object",
      "properties": {
        "userID": { "type": "string", "description": "The UID of the user who owns this conversation" },
        "imageURL": { "type": "string", "format": "uri" },
        "contextText": { "type": "string" },
        "analysis": { "type": "object" },
        "responses": { "type": "array" },
        "createdAt": { "type": "object", "description": "Firestore server timestamp" }
      },
      "required": ["userID", "contextText", "analysis", "responses", "createdAt"]
    },
    "SavedResponse": {
      "title": "SavedResponse",
      "description": "A response saved by the user",
      "type": "object",
      "properties": {
        "userID": { "type": "string", "description": "The UID of the user who saved this response" },
        "text": { "type": "string" },
        "createdAt": { "type": "object", "description": "Firestore server timestamp" }
      },
      "required": ["userID", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserData" },
      "description": "Stores user profiles and settings"
    },
    "/user_ai_profile/{userId}": {
      "schema": { "$ref": "#/entities/UserAIProfile" },
      "description": "Stores AI behavior profiles for users"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Stores analyzed conversations"
    },
    "/saved_responses/{responseId}": {
      "schema": { "$ref": "#/entities/SavedResponse" },
      "description": "Stores AI responses saved by users"
    }
  }
}
